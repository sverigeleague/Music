# Cloudflare Pages response headers (2026-10-25, page speed). Files that rarely change keep for a day in the browser,
# so a repeat visit does not re-check each flag, photo and logo; the page, app.js, styles.css and site/data/ keep
# Pages' default (re-checked on every visit), as they change with each daily build.
/fonts/*
  Cache-Control: public, max-age=604800
/flags/*
  Cache-Control: public, max-age=86400
/logos/*
  Cache-Control: public, max-age=86400
/photos/*
  Cache-Control: public, max-age=86400
/cards/*
  Cache-Control: public, max-age=3600
